    <!-- 订阅账号登录：xAI、GitHub Copilot。Claude 和 Google 不提供，原因写在 account_signin_skip。 -->
    <string name="account_signin_title">用订阅账号登录</string>
    <string name="account_signin_xai_title">用 Grok 订阅</string>
    <string name="account_signin_xai_body">用你的 xAI / Grok 订阅在 Mika 里调用 Grok。请求直接发到 api.x.ai 的 Responses 接口，不会转成别的协议。这项登录复用官方 Grok CLI 的公开客户端身份（不是 Mika 自己注册的应用）。xAI 可能不支持这种用法，账号有被限制的风险。令牌只加密存在这台手机上，不会写进日志。</string>
    <string name="account_signin_xai_continue">使用 Grok 订阅继续</string>
    <string name="account_signin_copilot_title">用 GitHub Copilot</string>
    <string name="account_signin_copilot_body">用你的 GitHub Copilot 订阅在 Mika 里调用模型。请求直接发到 Copilot 的 Chat Completions 接口，不会转成别的协议。这项登录复用 VS Code 里 GitHub Copilot 扩展的公开客户端身份（不是 Mika 自己注册的应用），并带上该接口要求的编辑器集成标识。GitHub 可能不支持这种用法，账号有被限制的风险。令牌只加密存在这台手机上，不会写进日志。</string>
    <string name="account_signin_copilot_continue">使用 Copilot 继续</string>
    <string name="account_signin_code">在浏览器里打开验证页，输入这个码：%1$s</string>
