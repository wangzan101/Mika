{
  "schema": 1,
  "id": "com.example.feishu",
  "name": "飞书消息",
  "version": "0.2.0",
  "kind": "capability",
  "minApp": "0.1.33",
  "author": "Mika 插件示例",
  "description": "飞书消息技能，加上通过自定义机器人 webhook 发消息的工具和设置页面。",
  "permissions": ["sandbox.run", "workspace.own", "settings.plugin", "network", "page"],
  "tools": [
    {
      "name": "send",
      "description": "通过飞书自定义机器人 webhook 发一条文本消息",
      "script": "scripts/send.py",
      "timeoutSec": 30,
      "risk": "external",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "maxCostUnits": 5,
      "inputSchema": {
        "type": "object",
        "properties": {
          "webhook": {
            "type": "string",
            "description": "飞书自定义机器人的 webhook 地址，形如 https://open.feishu.cn/open-apis/bot/v2/hook/..."
          },
          "text": {
            "type": "string",
            "description": "要发送的文本，最多 20000 字符"
          },
          "secret": {
            "type": "string",
            "description": "可选：机器人开启签名校验时填 secret"
          }
        },
        "required": ["webhook", "text"]
      }
    }
  ],
  "skills": [
    {
      "name": "feishu",
      "path": "skills/feishu",
      "display": "飞书消息"
    }
  ],
  "pages": [
    {
      "id": "home",
      "entry": "pages/index.html",
      "title": "飞书通知"
    }
  ],
  "settings": [
    {
      "key": "webhook",
      "type": "string",
      "label": "Webhook"
    },
    {
      "key": "secret",
      "type": "secret",
      "label": "签名 secret"
    }
  ]
}
